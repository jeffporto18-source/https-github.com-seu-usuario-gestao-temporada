# Copie para `.env` e preencha. O `.env` é ignorado pelo git.
# Carregado por `import "dotenv/config"` em server/_core/index.ts.

# ---------------------------------------------------------------- obrigatório
# MySQL. Sem isso o servidor sobe, mas toda query falha com "Database not available".
DATABASE_URL=mysql://usuario:senha@host:3306/nome_do_banco

# Segredo usado para assinar o cookie de sessão JWT (login por e-mail + senha).
JWT_SECRET=

# O token de sessão carrega este valor e `verifySession` (server/_core/sdk.ts)
# rejeita a sessão se ele vier vazio — sem isto o login grava o cookie mas toda
# requisição seguinte volta como anônima. Localmente qualquer texto serve, desde
# que não mude entre reinícios.
VITE_APP_ID=gestao-temporada-local

# ------------------------------------------------------------------- opcional
# Porta do servidor. O .claude/launch.json espera 3000.
PORT=3000

# Define o modo do servidor. Necessário no Windows, onde o prefixo
# `NODE_ENV=development` do script `pnpm dev` não funciona: sem isto o servidor
# tenta servir o build estático em vez de subir o Vite em modo dev.
NODE_ENV=development

# Cloudflare R2 — armazenamento de contratos, apólices e documentos de hóspede.
# Só é exigido no momento do upload; o resto do app funciona sem.
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET_NAME=

# Provedor de NFS-e. Sem isso a emissão continua simulada (payloads gerados,
# nada enviado).
NFSE_PROVIDER_URL=
NFSE_PROVIDER_TOKEN=

# Plataforma Manus — OAuth de fallback para o owner e APIs internas (LLM,
# geração de imagem, notificação). Não são necessárias para o login próprio.
OAUTH_SERVER_URL=
OWNER_OPEN_ID=
BUILT_IN_FORGE_API_URL=
BUILT_IN_FORGE_API_KEY=
